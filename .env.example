# 复制本文件为 .env 并填入真实值：
#     cp .env.example .env
# .env 已被 .gitignore 忽略，**永远不会进 git，也不会被 Cloudflare Pages 发布**。
# 绝不把真实密钥写进任何 .py / .js / .json 文件，也不要提交 .env。

# R2 S3 端点（Cloudflare → R2 → 概述页可查）
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# 桶名
R2_BUCKET=party-maker

# 下面两个才是机密：Cloudflare → R2 → Manage R2 API Tokens → 创建令牌
R2_ACCESS_KEY=<Access Key ID>
R2_SECRET_KEY=<Secret Access Key>

# 可选：Cloudflare REST API 令牌（S3 上传用不到，仅备用）
# CLOUDFLARE_API_TOKEN=<cfat_...>
